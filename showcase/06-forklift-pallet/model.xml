<mujoco model="forklift_pallet_delivery">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" cone="elliptic"/>
  <size nconmax="600" njmax="1200"/>
  <statistic center="0 0 0.78" extent="2.8"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
    <map znear="0.01" zfar="12"/>
    <headlight ambient="0.34 0.34 0.38" diffuse="0.74 0.74 0.72" specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.11 0.14 0.17" rgb2="0.22 0.25 0.28" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="7 7" reflectance="0.08"/>
    <material name="pad_mat" rgba="0.32 0.35 0.38 1" specular="0.12" roughness="0.76"/>
    <material name="forklift_orange" rgba="0.95 0.39 0.03 1" specular="0.35" roughness="0.32"/>
    <material name="forklift_dark" rgba="0.08 0.10 0.12 1" specular="0.28" roughness="0.46"/>
    <material name="mast_mat" rgba="0.17 0.20 0.23 1" specular="0.28" roughness="0.48"/>
    <material name="fork_mat" rgba="0.72 0.75 0.78 1" specular="0.42" roughness="0.26"/>
    <material name="pallet_mat" rgba="0.68 0.34 0.09 1" specular="0.16" roughness="0.72"/>
    <material name="crate_mat" rgba="0.12 0.55 0.88 1" specular="0.28" roughness="0.40"/>
    <material name="zone_mat" rgba="0.06 0.55 0.34 1" specular="0.2" roughness="0.54"/>
    <material name="rack_mat" rgba="0.45 0.48 0.52 1" specular="0.18" roughness="0.62"/>
    <material name="marker_yellow" rgba="1 0.9 0.02 1" emission="0.35"/>
    <material name="marker_cyan" rgba="0.02 1 0.95 1" emission="0.35"/>
    <material name="marker_magenta" rgba="1 0.04 0.68 1" emission="0.35"/>
    <material name="marker_green" rgba="0.08 1 0.24 1" emission="0.35"/>
    <material name="marker_orange" rgba="1 0.28 0.02 1" emission="0.35"/>
  </asset>

  <!-- Collision classes. A pair is tested when
       (contype1 & conaffinity2) || (contype2 & conaffinity1), and every class
       here now carries conaffinity 7, so no pair is filtered by a mask at all.
       The two the old masks swallowed were world-against-world ((1 & 6) = 0) and
       truck-against-truck ((2 & 5) = 0). Neither hid an overlap: every static
       body shares the world's weld root, and every truck part belongs either to
       the chassis weld group or to the carriage's, which are weld parent and
       child, so MuJoCo filters both structurally whatever the masks say. Opening
       them therefore costs nothing measurable - but a mask that hides a
       mechanism against itself would equally hide a mechanism that did meet. -->
  <default>
    <joint damping="1.0" armature="0.02"/>
    <geom friction="0.78 0.01 0.002" condim="6" solref="0.008 1" solimp="0.9 0.95 0.001"/>
    <default class="world_part">
      <geom contype="1" conaffinity="7"/>
    </default>
    <default class="robot_part">
      <geom contype="2" conaffinity="7"/>
    </default>
    <default class="payload_part">
      <geom contype="4" conaffinity="7"/>
    </default>
  </default>

  <worldbody>
    <light name="key_light" pos="-2.0 -2.5 4.6" dir="0.2 0.25 -1" directional="true" castshadow="true"/>
    <light name="fill_light" pos="2.5 1.6 3.3" dir="-0.6 -0.2 -1" directional="true" diffuse="0.42 0.45 0.5" specular="0.08 0.08 0.08"/>
    <camera name="delivery_camera" pos="3.6723 -4.6358 5.2237" quat="0.8296993376 0.4411589632 0.1605687312 0.3019858623" fovy="45"/>
    <geom name="ground_geom" type="plane" size="4.0 3.0 0.1" material="floor_mat" class="world_part"/>

    <!-- The loading stand carries the pallet at fork height. Its deck stops
         short of the pallet's near edge so the mast has somewhere to stand, and
         it is held up by four legs instead of floating: two world-welded bodies
         never report contact, so a hovering slab passes every contact audit. -->
    <body name="loading_pad" pos="-0.89 -0.9 0.63" childclass="world_part">
      <geom name="loading_pad_geom" type="box" size="0.47 0.46 0.03" material="pad_mat"/>
      <geom name="loading_pad_leg_a" type="box" pos="-0.41 -0.40 -0.33" size="0.05 0.05 0.30" material="pad_mat"/>
      <geom name="loading_pad_leg_b" type="box" pos="-0.41 0.40 -0.33" size="0.05 0.05 0.30" material="pad_mat"/>
      <geom name="loading_pad_leg_c" type="box" pos="0.41 -0.40 -0.33" size="0.05 0.05 0.30" material="pad_mat"/>
      <geom name="loading_pad_leg_d" type="box" pos="0.41 0.40 -0.33" size="0.05 0.05 0.30" material="pad_mat"/>
    </body>

    <!-- Every part of the truck collides. The chassis sits at z=0.03 so the
         drive wheels reach the floor instead of hovering 0.22 m above it, and
         the mast is raised by the same 0.22 m so the carriage, tines and lift
         stroke keep the world heights the interaction contract measures. -->
    <body name="forklift_base" pos="-2.6 -0.9 0.03" childclass="robot_part">
      <joint name="forklift_x" type="slide" axis="1 0 0" range="-0.3 4.8" damping="3.2" armature="0.04"/>
      <joint name="forklift_y" type="slide" axis="0 1 0" range="-0.4 2.5" damping="3.2" armature="0.04"/>
      <joint name="forklift_yaw" type="hinge" axis="0 0 1" range="-0.35 0.35" damping="2.0" armature="0.02"/>
      <geom name="forklift_base_geom" type="box" pos="0 0 0.18" size="0.42 0.34 0.18" mass="5.8" material="forklift_orange"/>
      <geom name="forklift_counterweight" type="box" pos="-0.29 0 0.42" size="0.19 0.31 0.22" mass="3.0" material="forklift_dark"/>
      <geom name="front_wheel_left" type="cylinder" pos="0.22 0.31 0.10" quat="0.7071068 0.7071068 0 0" size="0.13 0.075" mass="0.25" material="forklift_dark"/>
      <geom name="front_wheel_right" type="cylinder" pos="0.22 -0.31 0.10" quat="0.7071068 0.7071068 0 0" size="0.13 0.075" mass="0.25" material="forklift_dark"/>
      <geom name="rear_wheel_left" type="cylinder" pos="-0.27 0.29 0.07" quat="0.7071068 0.7071068 0 0" size="0.10 0.065" mass="0.2" material="forklift_dark"/>
      <geom name="rear_wheel_right" type="cylinder" pos="-0.27 -0.29 0.07" quat="0.7071068 0.7071068 0 0" size="0.10 0.065" mass="0.2" material="forklift_dark"/>
      <body name="forklift_mast" pos="0.42 0 0.42">
        <geom name="forklift_mast_left" type="box" pos="0 0.26 0.82" size="0.09 0.07 0.82" mass="2.4" material="mast_mat"/>
        <geom name="forklift_mast_right" type="box" pos="0 -0.26 0.82" size="0.09 0.07 0.82" mass="2.4" material="mast_mat"/>
        <body name="fork_carriage" pos="0 0 0.25">
          <joint name="fork_lift" type="slide" axis="0 0 1" range="0 0.35" damping="4.5" armature="0.03"/>
          <geom name="fork_carriage_geom" type="box" pos="0 0 0" size="0.14 0.32 0.10" mass="1.6" material="forklift_dark"/>
          <!-- The tines ride in the pallet's fork channel: 0.715-0.785 m at zero
               lift, between the stand deck at 0.66 and the pallet deck at 0.81. -->
          <body name="left_fork" pos="0.68 0.18 0.05">
            <geom name="left_fork" type="box" size="0.55 0.055 0.035" mass="0.45" material="fork_mat"/>
          </body>
          <body name="right_fork" pos="0.68 -0.18 0.05">
            <geom name="right_fork" type="box" size="0.55 0.055 0.035" mass="0.45" material="fork_mat"/>
          </body>
          <!-- A kinematic reference, not a marker: the contract reads this frame
               to check fork-to-pallet alignment. Drawn in group 2 it was an
               emissive ball 60 mm inside the pallet's centre runner whenever the
               tines were in the channel - which is the whole point of the tines.
               Group 4 is not rendered, so it stays a frame. -->
          <site name="fork_tip_site" type="sphere" pos="1.14 0 0.05" size="0.025" rgba="0.98 0.84 0.05 0.4" group="4"/>
        </body>
      </body>
    </body>

    <!-- The runners lie along the fork axis so the tines can enter the channel
         between them. Across it, as they were before, the tines rammed the near
         runner head-on and the lift only worked because the pallet was pinned. -->
    <body name="pallet" pos="-1.0 -0.9 0.88" childclass="payload_part">
      <freejoint name="pallet_free"/>
      <geom name="pallet_deck" type="box" size="0.50 0.40 0.07" mass="1.5" material="pallet_mat" friction="0.85 0.01 0.003"/>
      <geom name="pallet_runner_left" type="box" pos="0 0.34 -0.145" size="0.44 0.06 0.075" mass="0.30" material="pallet_mat"/>
      <geom name="pallet_runner_center" type="box" pos="0 0 -0.145" size="0.44 0.06 0.075" mass="0.30" material="pallet_mat"/>
      <geom name="pallet_runner_right" type="box" pos="0 -0.34 -0.145" size="0.44 0.06 0.075" mass="0.30" material="pallet_mat"/>
      <body name="payload_crate" pos="0 0 0.27">
        <geom name="payload_crate_geom" type="box" size="0.32 0.28 0.20" mass="0.8" material="crate_mat"/>
        <geom name="payload_crate_band" type="box" pos="0 0.285 0" size="0.33 0.012 0.21" mass="0.15" material="forklift_dark"/>
      </body>
      <!-- The engage decal belongs to the pallet, because "engage" names the
           pallet and not a patch of floor: painted on the deck it travels with
           the load and still reads correctly on the delivery stand. It lies flat
           on the deck top (local z 0.07) with its 0.006 half-height above that,
           so the underside is flush and the audit's downward ray travels exactly
           0.006 m. Local x 0.41 with radius 0.07 spans 0.34 .. 0.48: clear of
           the crate footprint (|x| <= 0.32, and the strap band reaches 0.33) and
           20 mm inside the deck edge at 0.50, so nothing on the pallet covers
           it. -->
      <site name="engage_pallet_marker" type="cylinder" pos="0.41 0 0.076" size="0.07 0.006" material="marker_magenta" group="2"/>
    </body>

    <!-- The delivery target is a stand with corner blocks, not a walled bin. A
         fork truck has to reverse its tines out at deck height, so a 0.24 m wall
         on the approach side is geometry the documented sequence cannot clear:
         the blocks locate the pallet and stay below the loaded tines. -->
    <body name="delivery_zone" pos="1.55 0.35 0.68" childclass="world_part">
      <geom name="delivery_zone_bottom" type="box" pos="0.11 0 0.0" size="0.47 0.56 0.04" material="zone_mat"/>
      <geom name="delivery_zone_leg_a" type="box" pos="-0.30 -0.50 -0.36" size="0.05 0.05 0.32" material="zone_mat"/>
      <geom name="delivery_zone_leg_b" type="box" pos="-0.30 0.50 -0.36" size="0.05 0.05 0.32" material="zone_mat"/>
      <geom name="delivery_zone_leg_c" type="box" pos="0.52 -0.50 -0.36" size="0.05 0.05 0.32" material="zone_mat"/>
      <geom name="delivery_zone_leg_d" type="box" pos="0.52 0.50 -0.36" size="0.05 0.05 0.32" material="zone_mat"/>
      <geom name="delivery_zone_corner_a" type="box" pos="-0.25 -0.48 0.07" size="0.04 0.04 0.03" material="zone_mat"/>
      <geom name="delivery_zone_corner_b" type="box" pos="-0.25 0.48 0.07" size="0.04 0.04 0.03" material="zone_mat"/>
      <geom name="delivery_zone_corner_c" type="box" pos="0.47 -0.48 0.07" size="0.04 0.04 0.03" material="zone_mat"/>
      <geom name="delivery_zone_corner_d" type="box" pos="0.47 0.48 0.07" size="0.04 0.04 0.03" material="zone_mat"/>
    </body>

    <body name="storage_rack" pos="0.10 1.15 0.72" childclass="world_part">
      <geom name="storage_rack_post_a" type="box" pos="-0.62 0 0.29" size="0.05 0.05 1.01" material="rack_mat"/>
      <geom name="storage_rack_post_b" type="box" pos="0.62 0 0.29" size="0.05 0.05 1.01" material="rack_mat"/>
      <geom name="storage_rack_shelf" type="box" pos="0 0 0.50" size="0.68 0.30 0.045" material="rack_mat"/>
      <geom name="storage_rack_top" type="box" pos="0 0 1.26" size="0.68 0.30 0.045" material="rack_mat"/>
    </body>

    <!-- Markers are decals painted on the surface each action happens on, not
         balls hanging in the air that the truck and its load drive straight
         through. Every one is a cylinder whose 0.006 m half-height equals its
         height above the surface underneath, so the underside is flush and the
         audit's downward ray travels exactly its own reach.
         The two loading-station decals mark the truck's own station: at the stop
         pose the chassis centre is at x = -2.10 and the mast at -2.10 + 0.42 =
         -1.68, so the pair sits directly under the stop line and under the lift
         column. They stand off to y = -1.55, which is 190 mm in front of the
         loading stand's deck (y >= -1.36) and 310 mm in front of the chassis
         (y >= -1.24), because a decal inside that footprint is roofed by the
         truck or the stand and cannot be read at all. The old pair hung at
         x = -0.02 and -0.15 on the y = -0.9 lane, 766 mm and 895 mm over bare
         floor at an x the truck never reaches: its stop pose is 1.7 m short of
         there and its route leaves that lane altogether.
         The delivery pair splits the same way: the truck's own arrival is a
         floor decal at its stop pose (0.45, 0.35), and the release is a decal on
         the stand deck. The deck top is 0.68 + 0.04 = 0.72 and spans
         x = 1.19 .. 2.13, y = -0.21 .. 0.91; the delivered pallet covers
         x = 1.05 .. 2.05, y = -0.05 .. 0.75, so the free deck is the two 0.16 m
         strips at y = -0.13 and y = 0.83. The near strip is the one that is
         still visible once the load is on the stand - from this camera the far
         strip disappears behind the pallet's own runners - and x = 1.66 sits
         between the corner blocks at 1.26 .. 1.34 and 1.98 .. 2.06.
         The inspection decal drops from 0.90 to the floor it was hovering
         840 mm above. It stays the standpoint beside the delivery stand, moved
         in from (2.35, -0.95) to (2.30, -0.82) because on the floor it sits
         lower in frame: at 0.90 m its line of sight left 12 % of the camera's
         half-height in hand, and on the floor (2.35, -0.95) read tan_y = -0.381
         against the 0.414 limit with a rim 0.014 further out. From (2.30, -0.82)
         the centre reads -0.362 and the rim -0.376. -->
    <site name="drive_to_pallet_marker" type="cylinder" pos="-2.10 -1.55 0.006" size="0.10 0.006" material="marker_yellow" group="2"/>
    <site name="raise_forks_marker" type="cylinder" pos="-1.68 -1.55 0.006" size="0.09 0.006" material="marker_cyan" group="2"/>
    <site name="carry_to_drop_zone_marker" type="cylinder" pos="0.45 0.35 0.006" size="0.10 0.006" material="marker_green" group="2"/>
    <site name="lower_forks_release_marker" type="cylinder" pos="1.66 -0.13 0.726" size="0.07 0.006" material="marker_orange" group="2"/>
    <site name="inspect_forklift_delivery_marker" type="cylinder" pos="2.30 -0.82 0.006" size="0.09 0.006" material="marker_magenta" group="2"/>
  </worldbody>

  <!-- The wheels are rigid geoms on a chassis whose only degrees of freedom are
       x, y and yaw, so they cannot roll: every metre the truck drives, the tread
       slides on the floor. At the default 0.78 that zero-clearance contact fights
       the drive hard enough to matter - the y servo saturated at 400 N for 744 of
       1100 steps and the loaded truck stick-slipped along at 0.09 m/s against a
       0.8 m/s command, ending a 0.9 m segment 190 mm short. That is the drag the
       old controller was writing joint coordinates to hide. What a rolling wheel
       actually costs is rolling resistance, 1 to 2 % of the load for a hard wheel
       on concrete, so the wheel/floor pairs are declared with friction 0.02 and
       condim 3: the same 0.9 m segment then finishes 3 mm out with the servo
       never leaving its force range. The floor keeps its 0.78 for everything
       else, which is why this is four pairs and not a change to the plane. -->
  <contact>
    <pair name="wheel_floor_front_left" geom1="ground_geom" geom2="front_wheel_left" condim="3" friction="0.02 0.02 0.001 0.0001 0.0001"/>
    <pair name="wheel_floor_front_right" geom1="ground_geom" geom2="front_wheel_right" condim="3" friction="0.02 0.02 0.001 0.0001 0.0001"/>
    <pair name="wheel_floor_rear_left" geom1="ground_geom" geom2="rear_wheel_left" condim="3" friction="0.02 0.02 0.001 0.0001 0.0001"/>
    <pair name="wheel_floor_rear_right" geom1="ground_geom" geom2="rear_wheel_right" condim="3" friction="0.02 0.02 0.001 0.0001 0.0001"/>
  </contact>

  <!-- The pallet is carried by a weld between the fork carriage and the pallet,
       engaged at the offset the load is measured to be sitting at once the tines
       have picked it up, so the constraint starts satisfied and nothing snaps.
       The nominal offset is the one the documented sequence produces: at the
       stop pose the carriage is at x = -2.10 + 0.42 = -1.68 and the pallet stays
       at x = -1.0, so 0.68 m along the tines; and with the load riding the tine
       top the pallet centre is 0.155 m above the carriage centre (tine top
       0.05 + 0.035 above the carriage plus the deck's 0.07 half-height).
       Overwriting the pallet's free-joint qpos every step, which is what this
       replaces, made a pallet in the air indistinguishable from a pallet on the
       stand and turned every release into a teleport. -->
  <equality>
    <weld name="pallet_grasp" body1="fork_carriage" body2="pallet" relpose="0.68 0 0.155 1 0 0 0"
          active="false" solref="0.01 1" solimp="0.97 0.995 0.001"/>
  </equality>

  <actuator>
    <!-- The chassis has no vertical degree of freedom, so its wheels carry no
         load and the only resistance along a drive axis is the joint's own
         damping plus the servo's kv. At kp 240 that still left the truck a long
         way behind its command: 17.0 kg of truck (20.35 with the pallet welded
         on) lags by (3.2 + 24) * 0.8 / 240 = 91 mm at 0.8 m/s and then creeps in
         at a natural frequency of sqrt(240/17) = 3.8 rad/s with damping ratio
         27.2 / (2 * sqrt(240 * 17)) = 0.21, which is why the old controller had
         to write joint coordinates whenever the residual passed 120 mm. At
         kp 1800 / kv 150 the ratio is 153.2 / (2 * sqrt(1800 * 17)) = 0.44 at
         10.3 rad/s, the moving lag falls to 68 mm and a held command settles
         inside a millimetre, so the residual never needs correcting. Peak demand
         is kp * 0.068 + kv * 0.8 = 242 N, inside the 400 N range. -->
    <position name="forklift_x_motor" joint="forklift_x" kp="1800" kv="150" ctrlrange="-0.3 4.8" forcerange="-400 400"/>
    <position name="forklift_y_motor" joint="forklift_y" kp="1800" kv="150" ctrlrange="-0.4 2.5" forcerange="-400 400"/>
    <position name="forklift_yaw_motor" joint="forklift_yaw" kp="80" kv="12" ctrlrange="-0.35 0.35" forcerange="-60 60"/>
    <position name="fork_lift_motor" joint="fork_lift" kp="6000" kv="300" ctrlrange="0 0.35" forcerange="-600 600"/>
  </actuator>
</mujoco>
