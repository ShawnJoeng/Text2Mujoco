        "interior_bounds": {"min": [-0.55, -0.45, 0.04], "max": [0.55, 0.45, 0.30]},
        "part_geom_names": ["delivery_zone_bottom", "delivery_zone_leg_a", "delivery_zone_leg_b", "delivery_zone_leg_c", "delivery_zone_leg_d", "delivery_zone_corner_a", "delivery_zone_corner_b", "delivery_zone_corner_c", "delivery_zone_corner_d"]
      },
