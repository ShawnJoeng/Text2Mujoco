  "interaction_points": [
    {
      "id": "start_conveyor_to_pickup",
      "affordance": "convey",
      "target": {"type": "actuator", "name": "conveyor_motor"},
      "marker_site": "conveyor_start_marker",
      "pose": {"position": [-0.55, 0.145, 0.890], "orientation_xyzw": [0, 0, 0, 1]},
      "action": {
        "mode": "direct",
        "command": "start_conveyor_to_pickup",
        "schema": {"type": "object", "properties": {"speed_mps": {"type": "number", "minimum": 0.2, "maximum": 1.0}}, "required": [], "additionalProperties": false}
      },
      "preconditions": ["parcel_state == 'on_belt'", "conveyor_state == 'stopped'"],
      "success_conditions": ["-0.11 <= parcel_x <= -0.05", "parcel_speed_mps < 0.05", "parcel_state == 'at_pickup'"],
      "depends_on": [],
      "effects": ["conveyor_state = 'stopped'", "parcel_state = 'at_pickup'"],
      "reset": {"conveyor_state": "stopped", "parcel_state": "on_belt"}
    },
    {
      "id": "move_arm_to_parcel",
      "affordance": "reach",
      "target": {"type": "joint", "name": "arm_shoulder"},
      "marker_site": "parcel_approach_marker",
      "pose": {"position": [-0.08, 0.145, 0.890], "orientation_xyzw": [0, 0, 0, 1]},
      "action": {
        "mode": "direct",
        "command": "move_arm_to_parcel",
        "schema": {"type": "object", "properties": {"speed_rad_s": {"type": "number", "minimum": 0.2, "maximum": 2.0}}, "required": [], "additionalProperties": false}
      },
      "preconditions": ["parcel_state == 'at_pickup'", "arm_state == 'home'"],
      "success_conditions": ["arm_state == 'at_parcel'", "distance(tool, parcel) <= 0.05 m"],
      "depends_on": ["start_conveyor_to_pickup"],
      "effects": ["arm_state = 'at_parcel'"],
      "reset": {"arm_state": "home"}
    },
    {
      "id": "grasp_parcel_with_arm",
      "affordance": "grasp",
      "target": {"type": "actuator", "name": "gripper_left_motor"},
      "marker_site": "parcel_grasp_marker",
      "pose": {"position": [-0.08, -0.145, 0.890], "orientation_xyzw": [0, 0, 0, 1]},
      "action": {
        "mode": "direct",
        "command": "grasp_parcel_with_arm",
        "schema": {"type": "object", "properties": {"close": {"type": "boolean"}}, "required": ["close"], "additionalProperties": false}
      },
      "preconditions": ["arm_state == 'at_parcel'", "parcel_state == 'at_pickup'"],
      "success_conditions": ["gripper_state == 'closed'", "grasp_weld_active == true", "distance(tool, parcel) <= 0.03 m", "parcel_state == 'grasped'"],
      "depends_on": ["move_arm_to_parcel"],
      "effects": ["gripper_state = 'closed'", "parcel_state = 'grasped'"],
      "reset": {"gripper_state": "open", "parcel_state": "on_belt"}
    },
    {
      "id": "move_arm_to_target_bin",
      "affordance": "transport",
      "target": {"type": "joint", "name": "arm_elbow"},
      "marker_site": "target_bin_approach_marker",
      "pose": {"position": [0.55, 0.00, 0.786], "orientation_xyzw": [0, 0, 0, 1]},
      "action": {
        "mode": "direct",
        "command": "move_arm_to_target_bin",
        "schema": {"type": "object", "properties": {"speed_rad_s": {"type": "number", "minimum": 0.2, "maximum": 2.0}}, "required": [], "additionalProperties": false}
      },
      "preconditions": ["parcel_state == 'grasped'", "gripper_state == 'closed'"],
      "success_conditions": ["arm_state == 'over_target_bin'", "parcel_state == 'grasped'"],
      "depends_on": ["grasp_parcel_with_arm"],
      "effects": ["arm_state = 'over_target_bin'"],
      "reset": {"arm_state": "home"}
    },
    {
      "id": "release_parcel_in_target_bin",
      "affordance": "release",
      "target": {"type": "actuator", "name": "gripper_left_motor"},
      "marker_site": "parcel_release_marker",
      "pose": {"position": [0.12, 0.30, 0.866], "orientation_xyzw": [0, 0, 0, 1]},
      "action": {
        "mode": "direct",
        "command": "release_parcel_in_target_bin",
        "schema": {"type": "object", "properties": {"open": {"type": "boolean"}}, "required": ["open"], "additionalProperties": false}
      },
      "preconditions": ["arm_state == 'over_target_bin'", "parcel_state == 'grasped'"],
      "success_conditions": ["gripper_state == 'open'", "grasp_weld_active == false", "parcel_state == 'inside_target_bin'", "parcel_speed_mps < 0.15", "tool_pitch_qpos <= -0.28 rad", "arm_state == 'withdrawn'"],
      "depends_on": ["move_arm_to_target_bin"],
      "effects": ["gripper_state = 'open'", "parcel_state = 'inside_target_bin'", "arm_state = 'withdrawn'"],
      "reset": {"gripper_state": "open", "parcel_state": "on_belt", "arm_state": "home"}
    },
    {
      "id": "inspect_handoff",
      "affordance": "inspect",
      "target": {"type": "camera", "name": "handoff_camera"},
      "marker_site": "handoff_inspection_marker",
      "pose": {"position": [0.72, 0.30, 0.786], "orientation_xyzw": [0, 0, 0, 1]},
      "action": {
        "mode": "direct",
        "command": "inspect_handoff",
        "schema": {"type": "object", "properties": {"output_dir": {"type": "string"}}, "required": ["output_dir"], "additionalProperties": false}
      },
      "preconditions": ["parcel_state == 'inside_target_bin'"],
      "success_conditions": ["handoff RGB-D capture is valid", "task_state == 'verified'"],
      "depends_on": ["release_parcel_in_target_bin"],
      "effects": ["task_state = 'verified'"],
      "reset": {"task_state": "pending"}
    }
  ],
  "sensors": [
    {
      "id": "handoff_rgbd_sensor",
      "type": "camera",
      "camera_name": "handoff_camera",
      "pose": {"position": [2.1258, -2.2258, 2.5989], "orientation_xyzw": [0.4483825660, 0.1631979076, 0.3005731548, 0.8258179558]},
      "frequency_hz": 30,
      "data": ["rgb", "depth", "camera_pose", "arm_joint_qpos", "parcel_position", "conveyor_state"]
    }
  ],
  "task": {
    "goal": "输送带把蓝色包裹送到取件位，机械臂抓取并放入蓝色目标箱，再由相机确认交接。",
    "success_conditions": ["parcel_state == 'inside_target_bin'", "gripper_state == 'open'", "task_state == 'verified'", "all interactions completed in dependency order"],
    "failure_conditions": ["non_finite_state == true", "red distractor bin is modified", "parcel leaves workbench bounds"],
    "reset_policy": "mj_resetData_and_task_state"
  },
  "outputs": {
    "save_mjcf": true,
    "mjcf_path": "./output/model.xml",
    "save_mjb": true,
    "mjb_path": "./output/model.mjb",
    "resolution": [640, 480]
  }
