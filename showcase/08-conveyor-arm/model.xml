<mujoco model="conveyor_robot_handoff_cell">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" cone="elliptic"/>
  <size nconmax="500" njmax="1000"/>
  <statistic center="0 0.10 0.88" extent="1.60"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
    <map znear="0.01" zfar="8"/>
    <headlight ambient="0.30 0.31 0.34" diffuse="0.72 0.74 0.76" specular="0.18 0.18 0.20"/>
  </visual>

  <asset>
    <texture name="ground_tex" type="2d" builtin="checker" rgb1="0.12 0.14 0.17" rgb2="0.22 0.24 0.27" width="512" height="512"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="5 5" reflectance="0.08"/>
    <material name="bench_mat" rgba="0.53 0.57 0.61 1" specular="0.18" roughness="0.62"/>
    <material name="frame_mat" rgba="0.08 0.10 0.13 1" specular="0.20" roughness="0.48"/>
    <material name="belt_mat" rgba="0.07 0.09 0.11 1" specular="0.12" roughness="0.82"/>
    <material name="rail_mat" rgba="0.34 0.38 0.43 1" specular="0.22" roughness="0.52"/>
    <material name="roller_mat" rgba="0.57 0.61 0.66 1" specular="0.34" roughness="0.32"/>
    <material name="arm_mat" rgba="0.95 0.31 0.07 1" specular="0.35" roughness="0.30"/>
    <material name="arm_dark_mat" rgba="0.20 0.23 0.27 1" specular="0.25" roughness="0.42"/>
    <material name="parcel_mat" rgba="0.04 0.30 0.92 1" specular="0.34" roughness="0.28"/>
    <material name="target_bin_mat" rgba="0.05 0.62 0.30 1" specular="0.24" roughness="0.42"/>
    <material name="distractor_mat" rgba="0.76 0.07 0.06 1" specular="0.24" roughness="0.42"/>
    <material name="marker_yellow" rgba="1 0.88 0.04 1" emission="0.35"/>
    <material name="marker_cyan" rgba="0.02 0.95 0.95 1" emission="0.35"/>
    <material name="marker_green" rgba="0.05 1 0.18 1" emission="0.35"/>
    <material name="marker_magenta" rgba="1 0.05 0.65 1" emission="0.35"/>
    <material name="marker_orange" rgba="1 0.35 0.02 1" emission="0.35"/>
  </asset>

  <!-- Collision classes. A pair collides when (contype1 & conaffinity2) or
       (contype2 & conaffinity1) is non-zero, so conaffinity="7" everywhere
       means every pair is genuinely tested, robot against its own links
       included. The deliberate nests - a hinge hub drawn inside the link it
       turns, a ram inside its sleeve, a jaw inside the palm it slides on -
       are named one by one in <contact> below, so an intended overlap is a
       reviewable decision instead of a side effect of a bitmask. -->
  <default>
    <geom friction="0.72 0.01 0.002" condim="6" solref="0.008 1" solimp="0.90 0.95 0.001"/>
    <default class="world_part">
      <geom contype="1" conaffinity="7"/>
    </default>
    <default class="robot_part">
      <geom contype="2" conaffinity="7"/>
    </default>
    <default class="payload_part">
      <geom contype="4" conaffinity="7"/>
    </default>
  </default>

  <worldbody>
    <light name="key_light" pos="-1.2 -1.1 2.8" dir="0.35 0.32 -1" directional="true" castshadow="true"/>
    <light name="fill_light" pos="1.4 0.3 2.0" dir="-0.7 -0.2 -1" directional="true" diffuse="0.42 0.44 0.48" specular="0.08 0.08 0.08"/>
    <camera name="handoff_camera" pos="2.1258 -2.2258 2.5989" quat="0.8258179558 0.4483825660 0.1631979076 0.3005731548" fovy="45"/>
    <geom name="ground_geom" type="plane" size="3 3 0.1" material="ground_mat" class="world_part"/>

    <!-- Bench top at z = 0.78. The half sizes cover both bins in plan: the
         distractor bin reaches y = 0.90, so a 0.575 m half depth would have
         left it hanging 325 mm off the edge. Leg half height 0.37 puts their
         bottom faces exactly on the ground plane. -->
    <body name="workbench" pos="0 0 0.74" childclass="world_part">
      <geom name="workbench_top_geom" type="box" size="1.05 0.95 0.04" material="bench_mat" friction="0.90 0.01 0.001"/>
      <geom name="workbench_leg_fl" type="box" pos="-0.95 -0.85 -0.37" size="0.04 0.04 0.37" material="frame_mat"/>
      <geom name="workbench_leg_fr" type="box" pos="0.95 -0.85 -0.37" size="0.04 0.04 0.37" material="frame_mat"/>
      <geom name="workbench_leg_bl" type="box" pos="-0.95 0.85 -0.37" size="0.04 0.04 0.37" material="frame_mat"/>
      <geom name="workbench_leg_br" type="box" pos="0.95 0.85 -0.37" size="0.04 0.04 0.37" material="frame_mat"/>
    </body>

    <!-- Conveyor frame seated on the bench: slab bottom at z = 0.78, belt top
         at z = 0.884. It ends at x = 0.00, clear of the target bin footprint
         that starts at x = 0.04, so nothing reaches into the bin interior the
         parcel is placed into. -->
    <body name="conveyor_frame" pos="-0.49 0 0.82" childclass="world_part">
      <geom name="conveyor_frame_geom" type="box" size="0.49 0.26 0.04" material="frame_mat" friction="0.82 0.01 0.001"/>
      <geom name="belt_surface_geom" type="box" pos="0 0 0.052" size="0.485 0.225 0.012" material="belt_mat" friction="0.95 0.01 0.001"/>
      <geom name="conveyor_left_rail" type="box" pos="0 0.245 0.08" size="0.485 0.018 0.055" material="rail_mat"/>
      <geom name="conveyor_right_rail" type="box" pos="0 -0.245 0.08" size="0.485 0.018 0.055" material="rail_mat"/>
    </body>
    <!-- Head and tail rollers. The collision cylinder is spun about its own
         symmetry axis, so its swept volume is the cylinder itself and the
         clearances below hold at every drive angle. -->
    <body name="conveyor_drive" pos="-0.94 0 0.90" childclass="robot_part">
      <joint name="conveyor_drive_hinge" type="hinge" axis="0 1 0" damping="0.12" armature="0.008"/>
      <geom name="conveyor_drive_geom" type="cylinder" size="0.055 0.06" quat="0.70710678 0.70710678 0 0" mass="0.35" material="roller_mat"/>
    </body>
    <body name="conveyor_tail" pos="-0.03 0 0.838" childclass="world_part">
      <geom name="conveyor_tail_geom" type="cylinder" size="0.04 0.06" quat="0.70710678 0.70710678 0 0" material="roller_mat"/>
    </body>

    <!-- Articulated handoff arm. The pedestal closes the 400 mm gap that used
         to sit between the bench top and the arm base, every jointed geom
         declares its own mass, and the tool column is drawn on both sides of
         its prismatic axis: a sleeve on the forearm and a ram inside it, so
         the hand never separates from the arm at any lift command. -->
    <body name="arm_base" pos="0.40 -0.30 1.26" childclass="robot_part">
      <geom name="arm_pedestal_geom" type="cylinder" pos="0 0 -0.28" size="0.07 0.20" material="frame_mat"/>
      <geom name="arm_base_geom" type="cylinder" size="0.12 0.08" material="arm_dark_mat"/>
      <body name="arm_link1" pos="0 0 0">
        <joint name="arm_shoulder" type="hinge" axis="0 0 1" range="-3.05 3.05" damping="1.5" armature="0.015"/>
        <geom name="arm_link1_geom" type="capsule" fromto="0 0 0 0.32 0 0" size="0.045" mass="0.65" material="arm_mat"/>
        <geom name="arm_shoulder_hub" type="cylinder" size="0.065 0.035" mass="0.28" material="arm_dark_mat"/>
        <body name="arm_link2" pos="0.32 0 0">
          <joint name="arm_elbow" type="hinge" axis="0 0 1" range="-2.8 2.8" damping="1.2" armature="0.012"/>
          <geom name="arm_link2_geom" type="capsule" fromto="0 0 0 0.28 0 0" size="0.040" mass="0.52" material="arm_mat"/>
          <geom name="arm_elbow_hub" type="cylinder" size="0.058 0.032" mass="0.22" material="arm_dark_mat"/>
          <body name="arm_link3" pos="0.28 0 0">
            <joint name="arm_wrist" type="hinge" axis="0 0 1" range="-2.8 2.8" damping="1.0" armature="0.010"/>
            <geom name="arm_link3_geom" type="capsule" fromto="0 0 0 0.16 0 0" size="0.035" mass="0.30" material="arm_mat"/>
            <geom name="arm_wrist_hub" type="cylinder" size="0.050 0.028" mass="0.16" material="arm_dark_mat"/>
            <!-- The lift axis, drawn. Sleeve spans world z 1.252..1.402, its
                 bottom inside the forearm capsule; the ram below stays at
                 least 43 mm up inside it at the fully extended stop. -->
            <geom name="lift_sleeve" type="cylinder" pos="0.16 0 0.067" size="0.048 0.075" mass="0.26" material="arm_dark_mat"/>
            <body name="arm_lift" pos="0.16 0 -0.075" gravcomp="1">
              <joint name="tool_z" type="slide" axis="0 0 1" range="-0.14 0.09" damping="3.0" armature="0.008"/>
              <geom name="lift_ram" type="cylinder" pos="0 0 0.11" size="0.026 0.14" mass="0.22" material="rail_mat"/>
              <body name="arm_tool" pos="0 0 -0.030" gravcomp="1">
                <joint name="tool_pitch" type="hinge" axis="0 1 0" range="-0.35 0.35" damping="2.5" armature="0.006"/>
                <geom name="tool_pitch_hub" type="cylinder" zaxis="0 1 0" size="0.034 0.030" mass="0.12" material="arm_dark_mat"/>
                <geom name="tool_palm_geom" type="box" pos="0 0 -0.025" size="0.075 0.115 0.025" mass="0.24" material="arm_dark_mat"/>
                <body name="left_finger" pos="0 0 -0.04" gravcomp="1">
                  <joint name="gripper_left_slide" type="slide" axis="0 1 0" range="-0.045 0" damping="2.0" armature="0.004"/>
                  <geom name="left_finger_geom" type="box" pos="0 0.116 0" size="0.035 0.012 0.055" mass="0.08" material="arm_mat"/>
                </body>
                <body name="right_finger" pos="0 0 -0.04" gravcomp="1">
                  <joint name="gripper_right_slide" type="slide" axis="0 1 0" range="0 0.045" damping="2.0" armature="0.004"/>
                  <geom name="right_finger_geom" type="box" pos="0 -0.116 0" size="0.035 0.012 0.055" mass="0.08" material="arm_mat"/>
                </body>
                <!-- Kinematic reference only, never drawn: a solid-looking ball
                     at the grasp centre is exactly what the parcel passes
                     through, because sites never generate contact. -->
                <site name="arm_tcp" type="sphere" pos="0 0 -0.115" size="0.012" rgba="1 0.45 0.02 0.4" group="4"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="blue_parcel" pos="-0.55 0 0.944" childclass="payload_part">
      <freejoint name="parcel_free"/>
      <geom name="blue_parcel_geom" type="box" size="0.06 0.06 0.06" mass="0.22" material="parcel_mat" friction="0.76 0.01 0.002"/>
    </body>

    <body name="blue_target_bin" pos="0.25 0.18 0.78" childclass="world_part">
      <!-- Floor top at local z = 0.08, which is interior_bounds.min[2] in
           scene_spec.json, so a 0.12 m parcel resting on it centres at world
           0.92 m: 0.06 m of local clearance inside the declared interior. -->
      <geom name="blue_bin_bottom" type="box" pos="0 0 0.04" size="0.21 0.21 0.04" material="target_bin_mat" friction="0.78 0.01 0.002"/>
      <geom name="blue_bin_left" type="box" pos="-0.22 0 0.135" size="0.01 0.21 0.125" material="target_bin_mat"/>
      <geom name="blue_bin_right" type="box" pos="0.22 0 0.135" size="0.01 0.21 0.125" material="target_bin_mat"/>
      <geom name="blue_bin_front" type="box" pos="0 -0.22 0.135" size="0.21 0.01 0.125" material="target_bin_mat"/>
      <geom name="blue_bin_back" type="box" pos="0 0.22 0.135" size="0.21 0.01 0.125" material="target_bin_mat"/>
      <!-- Release decal, flush on the bin floor. Offset into the far corner so
           it clears both the settled parcel footprint and the shadow the near
           rim casts along the camera ray. -->
      <site name="parcel_release_marker" type="cylinder" pos="-0.13 0.12 0.086" size="0.045 0.006" material="marker_orange" group="2"/>
    </body>
    <body name="red_distractor_bin" pos="0.25 0.68 0.78" childclass="world_part">
      <geom name="red_bin_bottom" type="box" pos="0 0 0.04" size="0.21 0.21 0.04" material="distractor_mat"/>
      <geom name="red_bin_left" type="box" pos="-0.22 0 0.135" size="0.01 0.21 0.125" material="distractor_mat"/>
      <geom name="red_bin_right" type="box" pos="0.22 0 0.135" size="0.01 0.21 0.125" material="distractor_mat"/>
      <geom name="red_bin_front" type="box" pos="0 -0.22 0.135" size="0.21 0.01 0.125" material="distractor_mat"/>
      <geom name="red_bin_back" type="box" pos="0 0.22 0.135" size="0.21 0.01 0.125" material="distractor_mat"/>
    </body>

    <!-- Task markers are decals, not floating balls: thin discs whose underside
         is flush with the surface they annotate - the belt at z = 0.884, the
         bench at z = 0.780 - so nothing has to pass through them. The belt
         pair sits beside the parcel lane rather than under it. -->
    <site name="conveyor_start_marker" type="cylinder" pos="-0.55 0.145 0.890" size="0.045 0.006" material="marker_yellow" group="2"/>
    <site name="parcel_approach_marker" type="cylinder" pos="-0.08 0.145 0.890" size="0.040 0.006" material="marker_cyan" group="2"/>
    <site name="parcel_grasp_marker" type="cylinder" pos="-0.08 -0.145 0.890" size="0.040 0.006" material="marker_green" group="2"/>
    <!-- The bin approach decal sits off the bin's +x wall rather than behind it:
         from the handoff camera a decal at x = 0.60, y = 0.18 is masked by the
         arm's own lift sleeve, and a marker the camera cannot see is not evidence
         of anything. -->
    <site name="target_bin_approach_marker" type="cylinder" pos="0.55 0 0.786" size="0.045 0.006" material="marker_magenta" group="2"/>
    <site name="handoff_inspection_marker" type="cylinder" pos="0.72 0.30 0.786" size="0.030 0.006" material="marker_yellow" group="2"/>
  </worldbody>

  <!-- Every overlap in this model, named. The drive roller is journalled inside
       the conveyor frame; each hinge hub is drawn inside the link it turns; the
       lift ram lives inside its sleeve; each jaw slides against the palm face.
       Nothing else is excluded, so robot-against-robot is a real contact and
       the arm has a boundary against its own links. -->
  <contact>
    <exclude name="drive_frame_nest" body1="conveyor_drive" body2="conveyor_frame"/>
    <exclude name="base_shoulder_nest" body1="arm_base" body2="arm_link1"/>
    <exclude name="shoulder_elbow_nest" body1="arm_link1" body2="arm_link2"/>
    <exclude name="elbow_wrist_nest" body1="arm_link2" body2="arm_link3"/>
    <exclude name="lift_sleeve_nest" body1="arm_link3" body2="arm_lift"/>
    <exclude name="lift_pitch_nest" body1="arm_link3" body2="arm_tool"/>
    <exclude name="pitch_hub_nest" body1="arm_lift" body2="arm_tool"/>
    <exclude name="left_jaw_palm_nest" body1="arm_tool" body2="left_finger"/>
    <exclude name="right_jaw_palm_nest" body1="arm_tool" body2="right_finger"/>
  </contact>

  <!-- The carry is a constraint, not a coordinate write. Declared inactive and
       toggled at run time from the offset measured at jaw close, so releasing
       the parcel in mid air drops it - which is what makes a parcel in the hand
       distinguishable from a parcel lying on the belt. -->
  <equality>
    <weld name="parcel_grasp" body1="arm_tool" body2="blue_parcel" relpose="0 0 -0.115 1 0 0 0"
          active="false" solref="0.01 1" solimp="0.96 0.99 0.001"/>
  </equality>

  <actuator>
    <velocity name="conveyor_motor" joint="conveyor_drive_hinge" kv="0.35" ctrlrange="-30 30"/>
    <position name="shoulder_motor" joint="arm_shoulder" kp="140" kv="14" ctrlrange="-3.05 3.05"/>
    <position name="elbow_motor" joint="arm_elbow" kp="140" kv="14" ctrlrange="-2.8 2.8"/>
    <position name="wrist_motor" joint="arm_wrist" kp="110" kv="11" ctrlrange="-2.8 2.8"/>
    <position name="tool_lift_motor" joint="tool_z" kp="900" kv="52" ctrlrange="-0.14 0.09"/>
    <position name="tool_pitch_motor" joint="tool_pitch" kp="90" kv="9" ctrlrange="-0.35 0.35"/>
    <position name="gripper_left_motor" joint="gripper_left_slide" kp="260" kv="16" ctrlrange="-0.045 0"/>
    <position name="gripper_right_motor" joint="gripper_right_slide" kp="260" kv="16" ctrlrange="0 0.045"/>
  </actuator>
</mujoco>
