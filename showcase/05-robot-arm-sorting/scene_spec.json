{
  "schema_version": "1.0",
  "backend": "mujoco",
  "source_prompt": "Create a tabletop robotic arm sorting cell. A three-joint arm approaches a blue part on a conveyor, closes its parallel gripper, transfers the part to a blue bin beside a red distractor bin, releases it, and verifies the result with an RGB-D camera. Every robot and object interaction must be visible and executable.",
  "assumptions": [
    "The scene uses SI meters, a Z-up frame, gravity [0, 0, -9.81], and a deterministic seed of 53.",
    "The arm is an articulated planar pick-and-place robot with shoulder, elbow, and wrist hinge joints plus two powered gripper slides.",
    "The generated controller uses deterministic joint-space waypoints and a task-level grasp attachment while the gripper is closed; MuJoCo still advances dynamics at every control step.",
    "The blue part is the commanded object and the red part is a collidable distractor that remains in the neighboring bin lane.",
    "The blue bin is an open five-piece receptacle with local interior bounds; the inspection action writes 640 x 480 RGB-D evidence under the package output directory."
  ],
  "open_questions": [],
