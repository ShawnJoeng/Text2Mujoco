    <site name="release_blue_part_marker" type="sphere" pos="0.78 -0.34 1.22" size="0.055" material="marker_green" group="2"/>
    <site name="inspect_sorting_marker" type="ellipsoid" pos="1.12 -0.62 0.86" size="0.055 0.035 0.018" material="marker_magenta" group="2"/>
  </worldbody>

  <actuator>
    <position name="arm_shoulder_motor" joint="arm_shoulder" kp="180" kv="20" ctrlrange="-2.8 1.8" forcerange="-180 180"/>
    <position name="arm_elbow_motor" joint="arm_elbow" kp="180" kv="18" ctrlrange="-2.8 2.8" forcerange="-150 150"/>
    <position name="arm_wrist_motor" joint="arm_wrist" kp="100" kv="12" ctrlrange="-2.4 2.4" forcerange="-80 80"/>
    <position name="gripper_left_motor" joint="gripper_left_slide" kp="220" kv="22" ctrlrange="-0.055 0" forcerange="-30 30"/>
    <position name="gripper_right_motor" joint="gripper_right_slide" kp="220" kv="22" ctrlrange="0 0.055" forcerange="-30 30"/>
  </actuator>
</mujoco>
