    <material name="gripper_mat" rgba="0.14 0.55 0.82 1" specular="0.35" roughness="0.28"/>
    <material name="blue_mat" rgba="0.02 0.32 0.95 1" specular="0.42" roughness="0.24"/>
    <material name="red_mat" rgba="0.92 0.08 0.07 1" specular="0.42" roughness="0.24"/>
    <material name="blue_bin_mat" rgba="0.02 0.43 0.88 1" specular="0.24" roughness="0.42"/>
    <material name="red_bin_mat" rgba="0.80 0.12 0.08 1" specular="0.24" roughness="0.42"/>
    <material name="belt_mat" rgba="0.06 0.07 0.08 1" specular="0.12" roughness="0.82"/>
    <material name="marker_yellow" rgba="1 0.9 0.02 1" emission="0.35"/>
    <material name="marker_cyan" rgba="0.02 1 0.95 1" emission="0.35"/>
    <material name="marker_magenta" rgba="1 0.04 0.68 1" emission="0.35"/>
    <material name="marker_green" rgba="0.08 1 0.24 1" emission="0.35"/>
