          <joint name="arm_elbow" type="hinge" axis="0 1 0" range="-2.8 2.8" damping="2.4" armature="0.018"/>
          <geom name="arm_forearm_geom" type="capsule" fromto="0 0 0 0.62 0 0" size="0.065" mass="0.9" material="arm_link_mat" contype="0" conaffinity="0"/>
          <geom name="arm_elbow_hub" type="cylinder" quat="0.7071068 0 0.7071068 0" size="0.095 0.075" material="joint_mat" contype="0" conaffinity="0"/>
          <body name="arm_wrist_link" pos="0.62 0 0">
            <joint name="arm_wrist" type="hinge" axis="0 1 0" range="-2.4 2.4" damping="1.4" armature="0.012"/>
            <geom name="arm_wrist_geom" type="capsule" fromto="0 0 0 0.13 0 0" size="0.05" mass="0.25" material="gripper_mat" contype="0" conaffinity="0"/>
            <body name="gripper" pos="0.13 0 0">
              <geom name="gripper_palm_geom" type="box" pos="0 0 -0.025" size="0.09 0.11 0.035" material="gripper_mat" contype="0" conaffinity="0"/>
