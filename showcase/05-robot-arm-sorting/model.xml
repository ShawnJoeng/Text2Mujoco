    <geom name="ground_geom" type="plane" size="3.5 3.0 0.1" material="floor_mat"/>

    <body name="worktable" pos="0 0 0.62">
      <geom name="worktable_top_geom" type="box" size="1.35 0.82 0.06" material="table_mat" friction="0.9 0.01 0.001"/>
      <geom name="worktable_leg_fl" type="box" pos="-1.18 -0.66 -0.38" size="0.055 0.055 0.38" material="frame_mat"/>
      <geom name="worktable_leg_fr" type="box" pos="1.18 -0.66 -0.38" size="0.055 0.055 0.38" material="frame_mat"/>
      <geom name="worktable_leg_bl" type="box" pos="-1.18 0.66 -0.38" size="0.055 0.055 0.38" material="frame_mat"/>
      <geom name="worktable_leg_br" type="box" pos="1.18 0.66 -0.38" size="0.055 0.055 0.38" material="frame_mat"/>
    </body>

    <body name="conveyor_frame" pos="0.23 0 0.76">
