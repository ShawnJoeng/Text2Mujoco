      <geom name="conveyor_roller_b" type="cylinder" pos="0.19 0 0.04" quat="0.7071068 0.7071068 0 0" size="0.08 0.24" material="frame_mat"/>
    </body>

    <body name="arm_base" pos="-0.35 0 0.70">
      <geom name="arm_base_geom" type="cylinder" pos="0 0 -0.175" size="0.24 0.525" material="arm_base_mat"/>
      <geom name="arm_base_ring" type="cylinder" pos="0 0 0.37" size="0.28 0.035" material="joint_mat"/>
      <body name="arm_upper_link" pos="0 0 0.82">
        <joint name="arm_shoulder" type="hinge" axis="0 1 0" range="-2.8 1.8" damping="3.0" armature="0.02"/>
        <geom name="arm_upper_geom" type="capsule" fromto="0 0 0 0.72 0 0" size="0.075" mass="1.2" material="arm_link_mat" contype="0" conaffinity="0"/>
        <geom name="arm_shoulder_hub" type="cylinder" quat="0.7071068 0 0.7071068 0" size="0.115 0.09" material="joint_mat" contype="0" conaffinity="0"/>
