      <geom name="blue_bin_front" type="box" pos="0.215 0 0.16" size="0.015 0.22 0.115" material="blue_bin_mat"/>
      <geom name="blue_bin_back" type="box" pos="-0.215 0 0.16" size="0.015 0.22 0.115" material="blue_bin_mat"/>
