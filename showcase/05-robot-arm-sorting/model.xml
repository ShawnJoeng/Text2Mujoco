              <body name="right_finger" pos="0 -0.105 -0.075">
                <joint name="gripper_right_slide" type="slide" axis="0 1 0" range="0 0.055" damping="1.5"/>
                <geom name="right_finger_geom" type="box" pos="0 0 -0.07" size="0.035 0.025 0.07" material="gripper_mat" contype="0" conaffinity="0"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="blue_part" pos="0.23 0 0.855">
      <freejoint name="blue_part_free"/>
      <geom name="blue_part_geom" type="cylinder" size="0.07 0.07" mass="0.16" material="blue_mat" friction="0.72 0.01 0.003"/>
      <site name="blue_part_top_site" type="sphere" pos="0 0 0.075" size="0.018" rgba="0.02 0.55 1 1" group="2"/>
    </body>
    <body name="red_part" pos="0.43 0.45 0.75">
      <freejoint name="red_part_free"/>
      <geom name="red_part_geom" type="cylinder" size="0.07 0.07" mass="0.16" material="red_mat" friction="0.72 0.01 0.003"/>
    </body>

    <body name="blue_bin" pos="0.78 0 0.70">
      <geom name="blue_bin_bottom" type="box" pos="0 0 0.045" size="0.23 0.22 0.045" material="blue_bin_mat"/>
