{
  "schema_version": "1.0",
  "backend": "mujoco",
  "source": "scene_spec.json",
  "scene": "robot_peg_insertion_assembly",
  "action_envelope": {
    "type": "object",
    "properties": {"id": {"type": "string"}, "payload": {"type": "object"}},
    "required": ["id", "payload"],
    "additionalProperties": false
  },
  "dependency_order": [
    "move_arm_to_peg",
    "grasp_peg_with_arm",
    "move_arm_to_socket",
    "insert_peg_into_socket",
    "release_assembled_peg",
    "inspect_assembly"
  ],
  "interaction_points": [
    {
      "id": "move_arm_to_peg",
      "target": {"type": "joint", "name": "arm_shoulder"},
      "marker_site": "peg_approach_marker",
      "pose": {"position": [0.21, 0.0, 1.01], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "reach",
      "action": {"mode": "direct", "command": "move_arm_to_peg", "schema": {"type": "object", "properties": {"speed_rad_s": {"type": "number", "minimum": 0.2, "maximum": 2.0}}, "required": [], "additionalProperties": false}},
      "preconditions": ["arm_state == 'home'"],
      "success_conditions": ["tool is above the red peg", "arm_state == 'at_peg'"],
      "depends_on": [],
      "effects": ["arm_state = 'at_peg'"],
      "reset": {"arm_state": "home"}
    },
    {
      "id": "grasp_peg_with_arm",
      "target": {"type": "joint", "name": "gripper_slide"},
      "marker_site": "grasp_peg_marker",
      "pose": {"position": [0.21, 0.0, 0.94], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "grasp",
      "action": {"mode": "direct", "command": "grasp_peg_with_arm", "schema": {"type": "object", "properties": {"close": {"type": "boolean"}}, "required": ["close"], "additionalProperties": false}},
      "preconditions": ["arm_state == 'at_peg'", "peg_state == 'free'"],
      "success_conditions": ["gripper_state == 'closed'", "peg_state == 'grasped'"],
      "depends_on": ["move_arm_to_peg"],
      "effects": ["gripper_state = 'closed'", "peg_state = 'grasped'"],
      "reset": {"gripper_state": "open", "peg_state": "free"}
    },
    {
      "id": "move_arm_to_socket",
      "target": {"type": "joint", "name": "arm_elbow"},
      "marker_site": "socket_approach_marker",
      "pose": {"position": [0.17, 0.21, 1.26], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "transport",
      "action": {"mode": "direct", "command": "move_arm_to_socket", "schema": {"type": "object", "properties": {"speed_rad_s": {"type": "number", "minimum": 0.2, "maximum": 2.0}}, "required": [], "additionalProperties": false}},
      "preconditions": ["peg_state == 'grasped'", "arm_state == 'at_peg'"],
      "success_conditions": ["tool is above the socket", "arm_state == 'at_socket'"],
      "depends_on": ["grasp_peg_with_arm"],
      "effects": ["arm_state = 'at_socket'"],
      "reset": {"arm_state": "home"}
    },
    {
      "id": "insert_peg_into_socket",
      "target": {"type": "joint", "name": "tool_z"},
      "marker_site": "insertion_marker",
      "pose": {"position": [0.17, 0.21, 1.14], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "insert",
      "action": {"mode": "direct", "command": "insert_peg_into_socket", "schema": {"type": "object", "properties": {"depth_m": {"type": "number", "minimum": 0.06, "maximum": 0.10}}, "required": [], "additionalProperties": false}},
      "preconditions": ["arm_state == 'at_socket'", "peg_state == 'grasped'"],
      "success_conditions": ["tool_z <= -0.06", "peg_state == 'inserted'"],
      "depends_on": ["move_arm_to_socket"],
      "effects": ["peg_state = 'inserted'", "tool_state = 'lowered'"],
      "reset": {"peg_state": "free", "tool_state": "raised"}
    },
    {
      "id": "release_assembled_peg",
      "target": {"type": "joint", "name": "gripper_slide"},
      "marker_site": "release_marker",
      "pose": {"position": [0.17, 0.21, 1.08], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "release",
      "action": {"mode": "direct", "command": "release_assembled_peg", "schema": {"type": "object", "properties": {"open": {"type": "boolean"}}, "required": ["open"], "additionalProperties": false}},
      "preconditions": ["peg_state == 'inserted'", "tool_state == 'lowered'"],
      "success_conditions": ["gripper_state == 'open'", "peg_state == 'seated'"],
      "depends_on": ["insert_peg_into_socket"],
      "effects": ["gripper_state = 'open'", "peg_state = 'seated'"],
      "reset": {"gripper_state": "open"}
    },
    {
      "id": "inspect_assembly",
      "target": {"type": "camera", "name": "assembly_camera"},
      "marker_site": "inspection_marker",
      "pose": {"position": [0.48, 0.36, 1.02], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "inspect",
      "action": {"mode": "direct", "command": "inspect_assembly", "schema": {"type": "object", "properties": {"output_dir": {"type": "string"}}, "required": ["output_dir"], "additionalProperties": false}},
      "preconditions": ["peg_state == 'seated'"],
      "success_conditions": ["assembly RGB-D capture is valid", "task_state == 'verified'"],
      "depends_on": ["release_assembled_peg"],
      "effects": ["task_state = 'verified'"],
      "reset": {"task_state": "pending"}
    }
  ]
}
