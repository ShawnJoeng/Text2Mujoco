<mujoco model="lever_ball_ramp_workbench">
  <compiler angle="radian" autolimits="true"/>
  <!-- The ball crosses the tray at about 1.0 m/s and is stopped by the tray's
       front wall, which is a pure impact transient: nothing sweeps through
       anything, the contact simply cannot stiffen in time. A contact's time
       constant is clamped to twice the integration step, so at timestep 0.002
       even the stiffest possible contact left a 3.14 mm overlap on that impact
       (1.37 mm with solref already at 0.002, because the clamp ignores it).
       Halving the step lets solref reach its 0.002 s floor and the same impact
       resolves inside 0.32 mm. -->
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" cone="elliptic"/>
  <size nconmax="300" njmax="600"/>
  <statistic center="0 0 0.72" extent="1.55"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
    <map znear="0.01" zfar="8"/>
    <headlight ambient="0.32 0.32 0.34" diffuse="0.72 0.72 0.7" specular="0.18 0.18 0.18"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.13 0.15 0.17" rgb2="0.23 0.25 0.27" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="5 5" reflectance="0.08"/>
    <material name="bench_mat" rgba="0.56 0.59 0.62 1" specular="0.15" roughness="0.65"/>
    <material name="frame_mat" rgba="0.12 0.14 0.16 1" specular="0.18" roughness="0.55"/>
    <material name="ramp_mat" rgba="0.77 0.79 0.81 1" specular="0.12" roughness="0.75"/>
    <material name="rail_mat" rgba="0.27 0.30 0.33 1" specular="0.18" roughness="0.62"/>
    <material name="lever_blue_mat" rgba="0.03 0.25 0.92 1" specular="0.35" roughness="0.3"/>
    <material name="gate_mat" rgba="0.95 0.64 0.08 1" specular="0.25" roughness="0.45"/>
    <material name="ball_purple_mat" rgba="0.58 0.06 0.82 1" specular="0.42" roughness="0.25"/>
    <material name="tray_mat" rgba="0.08 0.60 0.34 1" specular="0.18" roughness="0.55"/>
  </asset>

  <!-- Collision classes. A pair is tested when
       (contype1 & conaffinity2) || (contype2 & conaffinity1), so these masks
       give world-mechanism, world-ball and mechanism-ball contacts while
       filtering mechanism self-collision, which the lever and the gate never
       need: they stand 0.17 m apart and are coupled through their position
       actuators, not through contact. Every moving body carries a collidable
       geom. The lever used to be contype="0" conaffinity="0", which renders and
       weighs exactly the same while sweeping through the bench and its own
       mount without reporting a single contact. -->
  <default>
    <geom friction="0.65 0.01 0.002" condim="6" solref="0.002 1" solimp="0.98 0.999 0.0005"/>
    <default class="world_part">
      <geom contype="1" conaffinity="6"/>
    </default>
    <default class="robot_part">
      <geom contype="2" conaffinity="5"/>
    </default>
    <default class="payload_part">
      <geom contype="4" conaffinity="7"/>
    </default>
  </default>

  <worldbody>
    <light name="key_light" pos="-1.0 -1.1 2.7" dir="0.3 0.25 -1" directional="true" castshadow="true"/>
    <light name="fill_light" pos="1.3 0.5 1.9" dir="-0.8 -0.2 -1" directional="true" diffuse="0.38 0.4 0.45" specular="0.06 0.06 0.06"/>
    <camera name="inspection_camera" pos="1.2 -1.2 1.42" quat="0.7612142645 0.5235515583 0.2168621560 0.3153052722" fovy="48"/>

    <geom name="ground_geom" class="world_part" type="plane" size="2.5 2.5 0.1" material="floor_mat"/>

    <body name="lab_bench" pos="0 0 0.72">
      <geom name="lab_bench_top_geom" class="world_part" type="box" size="0.725 0.4 0.03" material="bench_mat" friction="0.9 0.01 0.001"/>
      <geom name="bench_leg_fl" class="world_part" type="box" pos="-0.64 -0.32 -0.36" size="0.035 0.035 0.36" material="frame_mat"/>
      <geom name="bench_leg_fr" class="world_part" type="box" pos="0.64 -0.32 -0.36" size="0.035 0.035 0.36" material="frame_mat"/>
      <geom name="bench_leg_bl" class="world_part" type="box" pos="-0.64 0.32 -0.36" size="0.035 0.035 0.36" material="frame_mat"/>
      <geom name="bench_leg_br" class="world_part" type="box" pos="0.64 0.32 -0.36" size="0.035 0.035 0.36" material="frame_mat"/>
    </body>

    <body name="ramp_track" pos="-0.15 0 0.9" quat="0.9925461516 0 0.1218693434 0">
      <geom name="ramp_track_geom" class="world_part" type="box" size="0.37 0.14 0.015" material="ramp_mat" friction="0.55 0.01 0.002"/>
    </body>
    <!-- Guard rails bolted onto the track surface, not sunk into it. Both rails
         and the track are welded to the world, so MuJoCo never builds that
         contact pair and no audit can see an overlap there; the old rails ran
         23 mm below the track's top face and 12.5 mm inside its side face. In
         track-local coordinates each rail now sits at (0, +-0.1525, 0.0525):
         bottom face 0.0525-0.0375 = 0.015 = the track's top face, inner face
         0.1525-0.0125 = 0.14 = the track's side face. World pose follows from
         the ramp's 0.244346 rad Y rotation: x = -0.15 + sin(t)*0.0525,
         z = 0.9 + cos(t)*0.0525. -->
    <body name="ramp_left_rail" pos="-0.1372986 0.1525 0.9509405" quat="0.9925461516 0 0.1218693434 0">
      <geom name="ramp_left_rail_geom" class="world_part" type="box" size="0.37 0.0125 0.0375" material="rail_mat"/>
    </body>
    <body name="ramp_right_rail" pos="-0.1372986 -0.1525 0.9509405" quat="0.9925461516 0 0.1218693434 0">
      <geom name="ramp_right_rail_geom" class="world_part" type="box" size="0.37 0.0125 0.0375" material="rail_mat"/>
    </body>

    <!-- The lever is an actuated body, so it collides, and its mount has to
         leave the swing somewhere to go. The old solid cylinder swallowed the
         hinge axis: the capsule's proximal cap sits on the pivot, so the two
         overlapped by 20 mm at rest, and MuJoCo does not filter that pair - the
         parent-child filter is skipped when the parent's weld root is the world,
         which lever_mount is. The mount is therefore a yoke: two cheeks whose
         inner faces stand 0.03 - 0.0225 = 7.5 mm clear of the capsule radius (a
         hinge about Y keeps the capsule inside |y| = 0.0225 at every angle),
         plus a foot plate whose top face (0.805) stays 12.7 mm below the lowest
         point the swept capsule reaches (pivot 0.83 + 0.0225*cos(1.1) - 0.0225 =
         0.8177 at the -1.1 rad end stop). Both parts stand on the bench top
         (0.75) instead of floating 40 mm above it. -->
    <body name="lever_mount" pos="-0.48 -0.29 0.79">
      <geom name="lever_mount_foot" class="world_part" type="box" pos="0 0 -0.0125" size="0.052 0.03 0.0275" material="frame_mat"/>
      <geom name="lever_mount_left_cheek" class="world_part" type="box" pos="0 0.0425 0.015" size="0.052 0.0125 0.055" material="frame_mat"/>
      <geom name="lever_mount_right_cheek" class="world_part" type="box" pos="0 -0.0425 0.015" size="0.052 0.0125 0.055" material="frame_mat"/>
      <body name="blue_lever" pos="0 0 0.04">
        <joint name="lever_hinge" type="hinge" axis="0 1 0" range="-1.1 0.05" damping="1.2" armature="0.01"/>
        <geom name="blue_lever_geom" class="robot_part" type="capsule" pos="0 0 0.11" size="0.0225 0.0875" mass="0.12" material="lever_blue_mat"/>
        <site name="lever_interaction_marker" type="sphere" pos="0 0 0.235" size="0.027" rgba="1 0.9 0.05 1" group="2"/>
      </body>
    </body>

    <!-- The gate is a guillotine barrier that stands on the ramp surface, not a
         blade driven through it. Its 0.135 m stroke is vertical while the track
         is inclined 14 deg, so a slot in the track would have to be 88 mm wide
         in track-local x to clear the whole stroke - wider than the 70 mm ball
         it is meant to hold back. The closed gate is therefore parked just above
         the surface: the ramp's top face under the gate's uphill edge is at
         z = 0.91455 - 0.24935*(x + 0.14637) = 0.95846 at x = -0.3225, and the
         gate's bottom face is at 1.036 - 0.065 = 0.971, so 12.5 mm of vertical
         clearance, 12.2 mm measured normal to the ramp. qpos 0 is the joint's
         own lower stop, so the closed height is held by the limit rather than by
         the servo; the measured droop past the stop is 0.22 mm, which is why the
         limit needs no stiffening here. Closed, the gate stands 0.13 m above the
         surface; lifted 0.1237 m its bottom (1.0947) clears the crown of a ball
         resting against its uphill face (1.038) by 56 mm. The old gate was
         parked 0.045 m lower, which pushed its lower corners straight through
         the 0.03 m slab and needed a contact exclude to stay invisible. -->
    <body name="release_gate" pos="-0.31 0 1.036">
      <joint name="gate_slide" type="slide" axis="0 0 1" range="0 0.135" damping="3.5" armature="0.01"/>
      <geom name="release_gate_geom" class="robot_part" type="box" size="0.0125 0.135 0.065" mass="0.18" material="gate_mat"/>
    </body>

    <body name="purple_ball" pos="-0.44 0 1.0239">
      <freejoint name="purple_ball_free"/>
      <geom name="purple_ball_geom" class="payload_part" type="sphere" size="0.035" mass="0.09" material="ball_purple_mat" friction="0.45 0.01 0.003"/>
    </body>

    <body name="target_tray" pos="0.41 0 0.755">
      <geom name="target_tray_bottom" class="world_part" type="box" pos="0 0 0.01" size="0.2 0.17 0.01" material="tray_mat" friction="0.7 0.01 0.002"/>
      <geom name="target_tray_left" class="world_part" type="box" pos="0 0.16 0.065" size="0.2 0.01 0.055" material="tray_mat"/>
      <geom name="target_tray_right" class="world_part" type="box" pos="0 -0.16 0.065" size="0.2 0.01 0.055" material="tray_mat"/>
      <geom name="target_tray_front" class="world_part" type="box" pos="0.19 0 0.065" size="0.01 0.15 0.055" material="tray_mat"/>
      <geom name="target_tray_back" class="world_part" type="box" pos="-0.19 0 0.025" size="0.01 0.15 0.015" material="tray_mat"/>
      <site name="target_zone_marker" type="cylinder" pos="0 0.105 0.026" size="0.035 0.008" rgba="0.02 1 0.9 1" group="2"/>
    </body>

    <site name="release_zone_marker" type="ellipsoid" pos="-0.42 0.1 1.045" size="0.035 0.016 0.009" rgba="1 0.08 0.62 1" group="2"/>
    <site name="camera_checkpoint_marker" type="sphere" pos="0.54 0.28 0.98" size="0.028" rgba="1 0.22 0.02 1" group="2"/>
    <!-- The checkpoint post is real scenery, so it collides like the rest of the
         world: it now runs from the bench top (0.75) to the marker it carries
         (0.98) instead of hovering 10 mm above the bench. -->
    <geom name="camera_checkpoint_post" class="world_part" type="cylinder" pos="0.54 0.28 0.865" size="0.008 0.115" material="frame_mat"/>
  </worldbody>

  <actuator>
    <position name="lever_position" joint="lever_hinge" kp="48" kv="5" ctrlrange="-1.05 0"/>
    <position name="gate_position" joint="gate_slide" kp="280" kv="18" ctrlrange="0 0.135"/>
  </actuator>
</mujoco>
