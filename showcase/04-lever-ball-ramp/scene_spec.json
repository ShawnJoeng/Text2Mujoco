  "interaction_points": [
    {
      "id": "pull_blue_lever",
      "affordance": "pull",
      "target": {"type": "actuator", "name": "lever_position"},
      "marker_site": "lever_interaction_marker",
      "pose": {
        "position": [-0.48, -0.29, 1.05],
        "orientation_xyzw": [0, 0, 0, 1]
      },
      "action": {
        "mode": "direct",
        "command": "pull_blue_lever",
        "schema": {
          "type": "object",
          "properties": {
            "pull_angle_rad": {"type": "number", "minimum": 0.8, "maximum": 1.05}
          },
          "required": []
        }
      },
      "preconditions": ["lever_state == 'ready'"],
      "success_conditions": ["lever_angle_rad <= -0.75", "gate_lift_m >= 0.1"],
      "depends_on": [],
      "effects": ["lever_state = 'pulled'", "gate_state = 'open'"],
      "reset": {"lever_state": "ready", "gate_state": "closed"}
    },
    {
      "id": "check_release_zone",
      "affordance": "observe_release",
      "target": {"type": "site", "name": "release_zone_marker"},
      "marker_site": "release_zone_marker",
      "pose": {
        "position": [-0.41, 0, 1.06],
        "orientation_xyzw": [0, 0, 0, 1]
      },
      "action": {
        "mode": "direct",
        "command": "check_release_zone",
        "schema": {
          "type": "object",
          "properties": {
            "max_steps": {"type": "integer", "minimum": 1, "maximum": 1200}
          },
          "required": []
        }
      },
      "preconditions": ["gate_state == 'open'"],
      "success_conditions": ["ball_position_x > -0.25"],
      "depends_on": ["pull_blue_lever"],
      "effects": ["release_zone_state = 'cleared'"],
      "reset": {"release_zone_state": "occupied"}
    },
    {
      "id": "confirm_target_tray",
      "affordance": "confirm_arrival",
      "target": {"type": "body", "name": "target_tray"},
      "marker_site": "target_zone_marker",
      "pose": {
        "position": [0.41, 0, 0.86],
        "orientation_xyzw": [0, 0, 0, 1]
      },
      "action": {
        "mode": "direct",
        "command": "confirm_target_tray",
        "schema": {
          "type": "object",
          "properties": {
            "max_steps": {"type": "integer", "minimum": 1, "maximum": 3000}
          },
          "required": []
        }
      },
      "preconditions": ["release_zone_state == 'cleared'"],
      "success_conditions": ["ball center inside target_tray.interior_bounds", "ball_speed_mps < 0.15"],
      "depends_on": ["check_release_zone"],
      "effects": ["target_state = 'occupied'"],
      "reset": {"target_state": "empty"}
    },
    {
      "id": "inspect_with_camera",
      "affordance": "inspect",
      "target": {"type": "camera", "name": "inspection_camera"},
      "marker_site": "camera_checkpoint_marker",
      "pose": {
        "position": [1.2, -1.2, 1.42],
        "orientation_xyzw": [0.5235515583, 0.216862156, 0.3153052722, 0.7612142645]
      },
      "action": {
        "mode": "direct",
        "command": "inspect_with_camera",
        "schema": {
          "type": "object",
          "properties": {
            "output_dir": {"type": "string"}
          },
          "required": ["output_dir"]
        }
      },
      "preconditions": ["target_state == 'occupied'"],
      "success_conditions": ["observation contains 640x480 RGB and finite depth"],
      "depends_on": ["confirm_target_tray"],
      "effects": ["inspection_state = 'captured'"],
      "reset": {"inspection_state": "pending"}
    }
  ],
  "sensors": [
    {
      "id": "inspection_rgbd",
      "type": "camera",
      "camera_name": "inspection_camera",
      "pose": {
        "position": [1.2, -1.2, 1.42],
        "orientation_xyzw": [0.5235515583, 0.216862156, 0.3153052722, 0.7612142645]
      },
      "frequency_hz": 30,
      "data": ["rgb", "depth", "camera_pose"]
    }
  ],
  "task": {
    "goal": "拉下蓝色杠杆升起挡板，让紫色小球沿斜坡滚入目标托盘，再用固定 RGB-D 相机确认结果。",
    "success_conditions": [
      "lever_state == 'pulled'",
      "gate_state == 'open'",
      "release_zone_state == 'cleared'",
      "target_state == 'occupied'",
      "inspection_state == 'captured'"
    ],
    "failure_conditions": [
      "non_finite_state == true",
      "ball_out_of_workspace == true"
    ],
    "reset_policy": "mj_resetData_and_task_state"
  },
  "outputs": {
    "save_mjcf": true,
    "mjcf_path": "./output/model.xml",
    "save_mjb": false,
    "resolution": [640, 480]
  }
}
