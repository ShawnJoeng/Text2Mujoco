    "description": "拉动蓝色杠杆升起挡板，使紫色小球沿带护栏斜坡滚入目标托盘，并从固定相机检查结果。",
    "runtime": {
      "mujoco_version": "3.2.7",
      "mode": "python",
      "headless": true,
      "gl_backend": "auto"
    },
    "world": {
      "units": "m",
      "up_axis": "Z",
      "gravity": [0, 0, -9.81],
      "ground": true,
      "seed": 17
    }
  },
