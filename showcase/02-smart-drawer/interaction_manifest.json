{
  "schema_version": "1.0",
  "backend": "mujoco",
  "source": "scene_spec.json",
  "scene": "smart_desktop_tool_drawer",
  "action_envelope": {
    "type": "object",
    "properties": {"id": {"type": "string"}, "payload": {"type": "object"}},
    "required": ["id", "payload"],
    "additionalProperties": false
  },
  "dependency_order": [
    "press_unlock_button",
    "pull_drawer_22cm",
    "inspect_open_drawer"
  ],
  "interaction_points": [
    {
      "id": "press_unlock_button",
      "target": {"type": "joint", "name": "unlock_button_slide"},
      "marker_site": "unlock_point_marker",
      "pose": {"position": [-0.20, -0.246, 1.245], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "press",
      "action": {
        "mode": "direct",
        "command": "press_unlock_button",
        "schema": {"type": "object", "properties": {"press_depth_m": {"type": "number", "minimum": 0.01, "maximum": 0.012}}, "required": []}
      },
      "preconditions": ["lock_state == 'locked'"],
      "success_conditions": ["unlock_button_joint_qpos >= 0.01", "lock_state == 'unlocked'"],
      "depends_on": [],
      "effects": ["lock_state = 'unlocked'"],
      "reset": {"lock_state": "locked", "unlock_button_joint_qpos": 0}
    },
    {
      "id": "pull_drawer_22cm",
      "target": {"type": "joint", "name": "drawer_slide"},
      "marker_site": "drawer_handle_marker",
      "pose": {"position": [0, -0.223, 0.937], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "open",
      "action": {
        "mode": "direct",
        "command": "pull_drawer_22cm",
        "schema": {"type": "object", "properties": {"distance_m": {"type": "number", "minimum": 0.22, "maximum": 0.22}}, "required": ["distance_m"]}
      },
      "preconditions": ["lock_state == 'unlocked'", "drawer_state == 'closed'"],
      "success_conditions": ["abs(drawer_joint_qpos - 0.22) <= 0.002"],
      "depends_on": ["press_unlock_button"],
      "effects": ["drawer_state = 'open_22cm'"],
      "reset": {"drawer_state": "closed", "drawer_joint_qpos": 0}
    },
    {
      "id": "inspect_open_drawer",
      "target": {"type": "camera", "name": "fixed_inspection_camera"},
      "marker_site": "camera_check_marker",
      "pose": {"position": [0.20, -0.191, 1.135], "orientation_xyzw": [0, 0, 0, 1]},
      "affordance": "inspect",
      "action": {
        "mode": "direct",
        "command": "inspect_open_drawer",
        "schema": {"type": "object", "properties": {"output_dir": {"type": "string"}}, "required": ["output_dir"]}
      },
      "preconditions": ["drawer_state == 'open_22cm'"],
      "success_conditions": ["fixed camera RGB-D capture is valid", "drawer_joint_qpos >= 0.218"],
      "depends_on": ["pull_drawer_22cm"],
      "effects": ["inspection_state = 'verified_open'"],
      "reset": {"inspection_state": "pending"}
    }
  ]
}
